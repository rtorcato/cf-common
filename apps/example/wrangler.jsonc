{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-common-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-26",

  // Everything below works with `wrangler dev` (local mode) using these
  // placeholder ids — Miniflare simulates KV/R2/D1 on disk, no Cloudflare
  // account needed. The ids only matter for `wrangler dev --remote` and
  // `wrangler deploy`, which need real resources and `wrangler login`
  // (or CLOUDFLARE_API_TOKEN in CI). Replace the placeholders then.
  "vars": {
    "GREETING": "hello from cf-common",
    // Cloudflare's public always-pass Turnstile test secret. For a real site key,
    // remove it and use `wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
  },
  // Fires the `scheduled` handler; locally use `wrangler dev --test-scheduled`.
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 10 } }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local-placeholder-kv" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "cf-common-example" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "cf-common-example" }],
    "consumers": [{ "queue": "cf-common-example" }]
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "cf-common-example",
      "database_id": "local-placeholder-d1"
    }
  ]
  // Workers AI runs on Cloudflare, not locally, so /ai needs `wrangler dev --remote`.
  // "ai": { "binding": "AI" }
}
