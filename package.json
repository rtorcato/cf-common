{
  "name": "@rtorcato/cf-common",
  "version": "1.9.0",
  "description": "Typed TypeScript wrappers and helpers for working with Cloudflare bindings and APIs.",
  "license": "MIT",
  "author": "Richard Torcato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtorcato/cf-common.git"
  },
  "homepage": "https://docs.torcato.dev/cf-common/",
  "bugs": {
    "url": "https://github.com/rtorcato/cf-common/issues"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "sync:agents": "node scripts/sync-agents.mjs",
    "check:agents": "node scripts/sync-agents.mjs --check",
    "verify": "pnpm check:agents && pnpm typecheck && pnpm check && pnpm exec vitest run",
    "size-limit": "size-limit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rtorcato/repo-ai": "^3.5.1",
    "@rtorcato/repo-tooling": "^6.1.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.4",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "4.147.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./env": {
      "import": "./dist/env/index.js",
      "types": "./dist/env/index.d.ts"
    },
    "./kv": {
      "import": "./dist/kv/index.js",
      "types": "./dist/kv/index.d.ts"
    },
    "./r2": {
      "import": "./dist/r2/index.js",
      "types": "./dist/r2/index.d.ts"
    },
    "./r2-presign": {
      "import": "./dist/r2-presign/index.js",
      "types": "./dist/r2-presign/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./assets": {
      "import": "./dist/assets/index.js",
      "types": "./dist/assets/index.d.ts"
    },
    "./d1": {
      "import": "./dist/d1/index.js",
      "types": "./dist/d1/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./request": {
      "import": "./dist/request/index.js",
      "types": "./dist/request/index.d.ts"
    },
    "./access": {
      "import": "./dist/access/index.js",
      "types": "./dist/access/index.d.ts"
    },
    "./turnstile": {
      "import": "./dist/turnstile/index.js",
      "types": "./dist/turnstile/index.d.ts"
    },
    "./ratelimit": {
      "import": "./dist/ratelimit/index.js",
      "types": "./dist/ratelimit/index.d.ts"
    },
    "./cron": {
      "import": "./dist/cron/index.js",
      "types": "./dist/cron/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    },
    "./ai-gateway": {
      "import": "./dist/ai-gateway/index.js",
      "types": "./dist/ai-gateway/index.d.ts"
    },
    "./pipelines": {
      "import": "./dist/pipelines/index.js",
      "types": "./dist/pipelines/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./queues": {
      "import": "./dist/queues/index.js",
      "types": "./dist/queues/index.d.ts"
    },
    "./ws": {
      "import": "./dist/ws/index.js",
      "types": "./dist/ws/index.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows/index.js",
      "types": "./dist/workflows/index.d.ts"
    },
    "./secrets": {
      "import": "./dist/secrets/index.js",
      "types": "./dist/secrets/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./vectorize": {
      "import": "./dist/vectorize/index.js",
      "types": "./dist/vectorize/index.d.ts"
    },
    "./hyperdrive": {
      "import": "./dist/hyperdrive/index.js",
      "types": "./dist/hyperdrive/index.d.ts"
    },
    "./do": {
      "import": "./dist/do/index.js",
      "types": "./dist/do/index.d.ts"
    },
    "./rpc": {
      "import": "./dist/rpc/index.js",
      "types": "./dist/rpc/index.d.ts"
    },
    "./email": {
      "import": "./dist/email/index.js",
      "types": "./dist/email/index.d.ts"
    },
    "./analytics": {
      "import": "./dist/analytics/index.js",
      "types": "./dist/analytics/index.d.ts"
    },
    "./images": {
      "import": "./dist/images/index.js",
      "types": "./dist/images/index.d.ts"
    }
  },
  "files": [
    "AGENTS.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": "biome check --fix --no-errors-on-unmatched",
    "*.{json,md,yml,yaml}": "biome format --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@rtorcato/js-common": "^5.0.0"
  },
  "peerDependencies": {
    "@cloudflare/puppeteer": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/puppeteer": {
      "optional": true
    }
  }
}
